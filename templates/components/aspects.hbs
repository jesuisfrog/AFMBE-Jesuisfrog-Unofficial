<div class="aspects-container">
    <h2 id="aspect-header" class="header-with-button">
        <button type="button" class="create-item" data-action="createItem" data-create="aspect">+</button>
        <span>{{localize 'AFMBE.Aspects.Title' power=this.actor.system.power}}</span>
    </h2>
    <table class="item-table">
        <thead>
            <tr>
                <th class="table-left-align">{{localize 'AFMBE.Common.Name'}}</th>
                <th>{{localize 'AFMBE.Common.Power'}}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#each actor.aspect as |item id|}}
            <tr class="item" data-item-id="{{item._id}}">
                <td class="item-name" data-action="viewItem">{{item.name}}</td>
                <td class="table-center-align">{{item.system.power}}</td>
                <td class="table-center-align"><a class="item-control item-delete" data-action="deleteItem" title="{{localize 'AFMBE.Items.Delete'}}"><i
                            class="fas fa-trash"></i></a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
