<div class="attribute-container">
    <h2 id="attributes-header">{{localize 'AFMBE.Attributes.Primary.Title'}}</h2>
    <div class="resource-container">
        <div class="resource">
            <button class="attribute-roll" type="button" data-action="attributeRoll" data-attribute-key="strength" data-attribute-label="{{localize 'AFMBE.Attributes.Primary.Strength'}}">{{localize 'AFMBE.Attributes.Primary.Strength'}}</button>
            <div class="resource-values attribute">
                <input type="number" name="system.primaryAttributes.strength.value"
