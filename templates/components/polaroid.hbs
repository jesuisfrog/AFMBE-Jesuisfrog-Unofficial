<div class="polaroid-container">
    <img class="polaroid" src="systems/afmbe-jesuisfrog/images/polaroid.png">
    <img class="profile-img" data-action="editImage" data-edit="img" src="{{actor.img}}">
    <div class="sheet-nav-container">
        <nav class="sheet-nav sheet-tabs tabs" data-group="primary">
            <a class="item {{tabs.core.cssClass}}" data-action="tab" data-group="primary" data-tab="core">{{localize 'AFMBE.Sheet.Tab.Core'}}</a>
            <a class="item {{tabs.equipment.cssClass}}" data-action="tab" data-group="primary" data-tab="equipment">{{localize 'AFMBE.Sheet.Tab.Equipment'}}</a>
        </nav>
        <select id="characterTypeSelect" name="system.characterType" data-type="String">
            {{#each actor.system.characterTypes as |type idx|}}
                <option value="{{idx}}" {{#if (eq ../actor.system.characterType idx)}}selected{{/if}}>{{localizeCharacterType type}}</option>
            {{/each}}
        </select>
    </div>
    <div class="profile-tags-container">
        <div class="tags-flex-container"></div>
    </div>
    <div class="xp-container">
        <div class="xp-flex-container">
            <h2>{{localize 'AFMBE.Common.XP'}}</h2>
            <input type="number" name="system.xp" value="{{actor.system.xp}}">
        </div>
    </div>
</div>
